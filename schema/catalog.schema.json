{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codecloud-dev.github.io/moxsh-plugins/schema/catalog.schema.json",
  "title": "moxsh 插件目录 catalog.json",
  "description": "moxsh App 插件商店直接消费的索引文件结构：顶层对象 + entries 数组。每条 entry 必须带 type，否则 App 会解析失败。 完整性/签名字段与 moxsh-suite 的 plugin-manifest.schema.json 对齐；单条目与包内 manifest 契约见 entry-schema.json。 安全（禁止回滚）：每条 entry 必须声明 minVersion（允许安装的最低版本）与 revokedVersions（已确认有漏洞、禁止安装/回滚的版本号）。这是可信索引侧的强制下限，运行时据此拦截降级/回滚；字段缺失即视为清单不合规。",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "repoVersion": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "description": "语义化版本 2.0.0：major.minor.patch 可带 -预发布 / +构建元数据；与运行时 PluginVersionPolicy 的 semver 解析器同构"
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "type",
        "minVersion",
        "revokedVersions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!\\.)[A-Za-z0-9._-]+$",
          "description": "插件唯一标识：仅字母数字与 . _ -，不以 . 开头"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semver",
          "description": "语义化版本号（当前可安装版本）；与 minVersion 共用完整锚定的 semver 定义，禁止 1.0.1garbage 之类绕过"
        },
        "type": {
          "type": "string",
          "enum": [
            "plugin",
            "skill",
            "theme",
            "rootfs"
          ],
          "description": "缺此字段 App 会解析失败"
        },
        "minVersion": {
          "$ref": "#/$defs/semver",
          "description": "该插件允许安装的最低版本：低于它一律拒装（含全新安装与回滚覆盖）。修复漏洞后应抬到此值，形成版本地板。"
        },
        "revokedVersions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semver"
          },
          "uniqueItems": true,
          "description": "已确认有漏洞、禁止安装/回滚的版本号数组。命中即拒绝；运行时按 semver 优先级比较，防止改动写法绕过。可为空数组 []。"
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "minAppVersion": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price": {
          "type": "number",
          "description": "0 为免费"
        },
        "purchased": {
          "type": "boolean"
        },
        "sizeBytes": {
          "type": "number",
          "description": "包体积（字节）；包体未发布时为 0 占位，须同时标 packageStatus=planned"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "packageStatus": {
          "type": "string",
          "enum": [
            "planned",
            "available",
            "yanked"
          ],
          "description": "包体就绪状态；planned 表示仅占位、App 安装会提示「包源未配置」"
        },
        "signingKeyId": {
          "type": "string",
          "description": "签名所用密钥 id，对应 integrity.signature.keyId；密钥轮换时用于定位公钥"
        },
        "integrity": {
          "$ref": "#/$defs/integrity",
          "description": "完整性与签名信息，字段结构对齐 moxsh-suite/spec/plugin-manifest.schema.json"
        }
      },
      "additionalProperties": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "description": "与 moxsh-suite/spec/plugin-manifest.schema.json 的 $defs.integrity 同构。",
      "properties": {
        "checksum": {
          "type": "object",
          "required": [
            "algo",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algo": {
              "type": "string",
              "enum": [
                "sha256",
                "sha512"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "signature": {
          "type": "object",
          "required": [
            "algo",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algo": {
              "type": "string",
              "enum": [
                "ed25519",
                "rsa-pss",
                "ecdsa"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "keyId": {
              "type": "string"
            },
            "certFingerprint": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
