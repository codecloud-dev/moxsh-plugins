{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codecloud-dev.github.io/moxsh-plugins/schema/catalog.schema.json",
  "title": "moxsh 插件目录 catalog.json",
  "description": "moxsh App 插件商店直接消费的索引文件结构：顶层对象 + entries 数组。每条 entry 必须带 type，否则 App 会解析失败。 完整性/签名字段与 moxsh-suite 的 plugin-manifest.schema.json 对齐；单条目与包内 manifest 契约见 entry-schema.json。",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "repoVersion": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!\\.)[A-Za-z0-9._-]+$",
          "description": "插件唯一标识：仅字母数字与 . _ -，不以 . 开头"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "语义化版本号"
        },
        "type": {
          "type": "string",
          "enum": [
            "plugin",
            "skill",
            "theme",
            "rootfs"
          ],
          "description": "缺此字段 App 会解析失败"
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "minAppVersion": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price": {
          "type": "number",
          "description": "0 为免费"
        },
        "purchased": {
          "type": "boolean"
        },
        "sizeBytes": {
          "type": "number",
          "description": "包体积（字节）；包体未发布时为 0 占位，须同时标 packageStatus=planned"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "packageStatus": {
          "type": "string",
          "enum": [
            "planned",
            "available",
            "yanked"
          ],
          "description": "包体就绪状态；planned 表示仅占位、App 安装会提示「包源未配置」"
        },
        "signingKeyId": {
          "type": "string",
          "description": "签名所用密钥 id，对应 integrity.signature.keyId；密钥轮换时用于定位公钥"
        },
        "integrity": {
          "$ref": "#/$defs/integrity",
          "description": "完整性与签名信息，字段结构对齐 moxsh-suite/spec/plugin-manifest.schema.json"
        }
      },
      "additionalProperties": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "description": "与 moxsh-suite/spec/plugin-manifest.schema.json 的 $defs.integrity 同构。",
      "properties": {
        "checksum": {
          "type": "object",
          "required": [
            "algo",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algo": {
              "type": "string",
              "enum": [
                "sha256",
                "sha512"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "signature": {
          "type": "object",
          "required": [
            "algo",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algo": {
              "type": "string",
              "enum": [
                "ed25519",
                "rsa-pss",
                "ecdsa"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "keyId": {
              "type": "string"
            },
            "certFingerprint": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
