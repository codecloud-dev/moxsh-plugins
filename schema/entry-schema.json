{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codecloud-dev.github.io/moxsh-plugins/schema/entry-schema.json",
  "title": ".mox 包内 manifest.json 契约",
  "description": "与 terminal-core/src/moxpkg.rs 的 MoxManifest::from_bytes 同源：id/name/version/type 缺一即 BadManifest，非法包不能通过校验。另给出与 moxsh-suite/spec/plugin-manifest.schema.json 对齐的 integrity 字段定义，供打包流程接入后使用。 安全（禁止回滚）：本契约允许包内 manifest 携带 minVersion / revokedVersions 作为「自述」信息，但二者在包内只是 advisory（包由作者/打包器生成，不能自证可信）；真正强制执行的版本地板与撤销名单以签名后的 catalog.json 为准，由运行时 PluginVersionPolicy 校验。故二者在此为可选字段，不进 required。",
  "type": "object",
  "required": ["id", "name", "version", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!\\.)[A-Za-z0-9._-]+$",
      "description": "插件唯一标识；与 catalog.json 的 entry.id 必须一致"
    },
    "name": { "type": "string", "minLength": 1, "description": "显示名" },
    "version": {
      "$ref": "#/$defs/semver",
      "description": "语义化版本 2.0.0，如 1.0.1。必须引用完整锚定的 semver 定义：旧的内联前缀正则（结尾无 $）会把 1.0.1garbage、1.0.1;rm -rf / 当成合法版本"
    },
    "type": {
      "type": "string",
      "enum": ["plugin", "skill", "theme", "rootfs"],
      "description": "缺此字段 App 会解析失败"
    },
    "minVersion": {
      "$ref": "#/$defs/semver",
      "description": "可选自述：本包认为允许安装的最低版本。强制执行以 catalog.json 为准。"
    },
    "revokedVersions": {
      "type": "array",
      "items": { "$ref": "#/$defs/semver" },
      "uniqueItems": true,
      "description": "可选自述：本包声明的已撤销版本号。强制执行以 catalog.json 为准；可为空数组 []。"
    },
    "minAppVersion": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": true,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "description": "语义化版本 2.0.0：major.minor.patch 可带 -预发布 / +构建元数据；与运行时 PluginVersionPolicy 的 semver 解析器同构"
    },
    "integrity": {
      "type": "object",
      "description": "字段结构对齐 moxsh-suite/spec/plugin-manifest.schema.json 的 $defs.integrity。",
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "type": "object",
          "required": ["algo", "value"],
          "additionalProperties": false,
          "properties": {
            "algo": { "type": "string", "enum": ["sha256", "sha512"] },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "signature": {
          "type": "object",
          "required": ["algo", "value"],
          "additionalProperties": false,
          "properties": {
            "algo": { "type": "string", "enum": ["ed25519", "rsa-pss", "ecdsa"] },
            "value": { "type": "string", "minLength": 1 },
            "keyId": { "type": "string" },
            "certFingerprint": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
